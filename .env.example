# ============================================
# Plantilla de variables de entorno para una instancia nueva.
# Copiar a .env y llenar con los valores reales de ESTE cliente/instancia.
# Nunca comitear el .env real -- solo esta plantilla con valores de ejemplo.
# ============================================

# ============================================
# IDENTIDAD DE LA EMPRESA (por cliente -- ver backend/config/settings.py)
# ============================================
EMPRESA_NOMBRE=FRIPARTS
# Prefijo por defecto que se antepone a un código de producto numérico
# huérfano (ej. "7008" -> "FR-7008"). Dejar vacío si el cliente no usa
# prefijos de producto.
EMPRESA_PREFIJO_PRODUCTO=FR-

# Listas de catálogo a excluir de ciertos reportes, separadas por comas.
# Vacías por defecto para un cliente nuevo -- llenar solo si aplica.
# CATALOGO_REFERENCIAS_EXCLUIDAS_TOP=
# CATALOGO_PREFIJOS_EXCLUIDOS_MENOS_VENDIDOS=
# CATALOGO_PREFIJOS_EXCLUIDOS_SIN_ROTACION=

# ============================================
# BASE DE DATOS (CRITICO - una base de datos propia por instancia/cliente)
# ============================================
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# ============================================
# DOMINIO Y CORS
# ============================================
# Subdominio real de esta instancia (y localhost para pruebas).
CORS_ALLOWED_ORIGINS=https://cliente.fritech.com,http://localhost:5005,http://127.0.0.1:5005

# ============================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=generar-una-clave-aleatoria-larga
FLASK_SECRET_KEY=generar-otra-clave-aleatoria-larga
JWT_PWA_SECRET=generar-otra-clave-aleatoria-larga

# ============================================
# CONFIGURACIÓN DE CACHÉ
# ============================================
CACHE_TTL=120
CACHE_ENABLED=true

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================
# NOTIFICACIONES PUSH (PWA) — generar un par de claves VAPID propio por
# instancia con `vapid --gen` o la librería pywebpush; no reutilizar las de
# otro cliente.
# ============================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@delcliente.com

# ============================================
# INTEGRACIÓN ERP WORLD OFFICE (solo si el cliente usa WO -- ver Ficha
# Comercial, ítem "Integración WO"). Datos reales del WO de ESTE cliente,
# nunca los de otro.
# ============================================
WO_SERVER=
WO_DB=
WO_USER=
WO_PASSWORD=
WO_SYNC_API_KEY=generar-un-token-aleatorio-propio
SYNC_TOKEN=generar-un-token-aleatorio-propio
API_RENDER_URL=https://cliente.fritech.com/api/wo/recibir_datos

# ============================================
# GOOGLE (IA / Drive) — opcional, solo si el cliente usa estas integraciones
# ============================================
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_REPORTS_FOLDER_ID=
GSHEET_KEY=
GSHEET_FILE_NAME=
